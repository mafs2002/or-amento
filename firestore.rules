rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só estes dois emails (com conta criada em Authentication) leem e escrevem.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['EMAIL_1@exemplo.com', 'EMAIL_2@exemplo.com'];
    }
  }
}
